From: Philippe Coval <philippe.coval@vates.tech>
Date: Wed, 25 Mar 2026 17:37:47 +0100
Subject: udev-rule-to-stop-device-mapper-running-blkid-on

---
 udev/13-dm-disk.rules.in | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/udev/13-dm-disk.rules.in b/udev/13-dm-disk.rules.in
index 5355810..e0b7b49 100644
--- a/udev/13-dm-disk.rules.in
+++ b/udev/13-dm-disk.rules.in
@@ -17,6 +17,9 @@ ENV{DM_UDEV_DISABLE_DISK_RULES_FLAG}=="1", GOTO="dm_end"
 SYMLINK+="disk/by-id/dm-name-$env{DM_NAME}"
 ENV{DM_UUID}=="?*", SYMLINK+="disk/by-id/dm-uuid-$env{DM_UUID}"
 
+# XenServer - do not process SR Volume groups
+ACTION!="add|change", ENV{DM_VG_NAME}=="VG_XenStorage*", GOTO="dm_end"
+
 ENV{DM_SUSPENDED}=="1", GOTO="dm_end"
 ENV{DM_NOSCAN}=="1", GOTO="dm_watch"
 
